# Snapshots of third-party stylesheets, refetch before running the demos.
deepseek-chat/build/ds-main.css

# Browser profiles and caches created by the verification scripts.
deepseek-chat/build/profile*/
**/__pycache__/
*.pyc
*.log
# Screenshots are rendered into the images folder before being committed.
deepseek-chat/build/*.png
deepseek-chat/build/*.json
# DSH frontend stylesheet snapshots, refetch before running the demos.
dsh/build/*.css
dsh/build/css/
dsh/build/*.json
dsh/build/profile*/